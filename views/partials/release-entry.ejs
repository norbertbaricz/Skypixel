<article class="release-entry reveal" data-release-project="<%= release.projectName %>"><div class="release-identity"><%- projectIdentity(project) %><div><p class="card-category"><%= project.category %></p><h2><%= project.title %></h2></div></div><div class="release-content"><div class="release-meta"><span class="release-tag"><%= release.tag %></span><time datetime="<%= release.publishedAt || '' %>"><%= formatDate(release.publishedAt) %></time></div><h3><%= release.title || release.tag %></h3><% if(release.body){ %><p class="release-excerpt"><%= releaseExcerpt(release.body) %></p><% } else { %><p class="release-excerpt">Release details and available files are in the project.</p><% } %><div class="release-entry-actions"><button class="text-link" type="button" data-open-project="<%= project.name %>" data-open-tab="release">Notes & downloads <%- icon('right') %></button><a class="text-link muted-link" href="<%= safeUrl(project.releasesUrl) %>" target="_blank" rel="noopener noreferrer">Release history <%- icon('arrow') %></a></div></div></article>

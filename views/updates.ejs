<%- include('partials/head') %>
<section class="page-hero container"><p class="eyebrow hero-enter">THE CHANGELOG</p><h1 class="hero-enter delay-1">Keep up with<br> <span class="gold-text">what's next.</span></h1><p class="page-description hero-enter delay-2">The latest published release from each project. Real version notes, straight from GitHub.</p></section>
<section class="container updates-section"><div class="updates-toolbar reveal"><label for="release-project">Show releases for<select id="release-project"><option value="">All projects</option><% projects.filter(p=>p.release).forEach(p=>{ %><option value="<%= p.name %>"><%= p.title %></option><% }); %></select></label><p class="sync-status" data-sync-status>Saved catalog<%= snapshot.syncedAt ? ' · ' + formatDate(snapshot.syncedAt) : '' %></p></div><div class="release-feed" id="release-feed" aria-live="polite"><% releases.forEach(release=>{ const project=projects.find(p=>p.name===release.projectName); %><%- include('partials/release-entry', {release,project}) %><% }); %></div><div class="empty-state" id="release-empty" <%- releases.length ? 'hidden' : '' %>><%- icon('clock') %><h2>No release here yet.</h2><p>Projects without a published release are still available in the collection.</p><a class="text-link" href="/projects">Explore projects <%- icon('right') %></a></div><p class="catalog-footnote">This feed shows the latest release for each project. Earlier versions stay in the repository's release history.</p></section>
<%- include('partials/footer') %>

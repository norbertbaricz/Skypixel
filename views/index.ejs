<%- include('partials/head') %>
<section class="hero home-hero" aria-label="Welcome to Skypixel Framework"><div class="hero-background" aria-hidden="true"></div><div class="container hero-inner"><div class="hero-emblem hero-enter"><%- include('partials/brand-logo', {size:80, altText:'Skypixel Framework SP emblem', eager:true}) %></div><p class="eyebrow hero-enter">SKYPIXEL FRAMEWORK · BY <%= creatorName.toUpperCase() %></p><h1 class="hero-enter delay-1">Ideas into<br> <span class="gold-text">something useful.</span></h1><p class="hero-description hero-enter delay-2">Tools for your games, your community, and your everyday setup.<br> One identity. Always something new to build.</p><div class="hero-actions hero-enter delay-3"><a class="button button-gold" href="/projects">Explore projects <%- icon('right') %></a><a class="text-link" href="/about">Behind Skypixel <%- icon('arrow') %></a></div><a class="home-scroll hero-enter delay-3" href="#explore" aria-label="Explore the Skypixel hub"><%- icon('down') %></a></div></section>
<section class="container hub-section" id="explore"><div class="section-heading reveal"><div><p class="eyebrow">MORE THAN A COLLECTION</p><h2>A place to keep exploring.</h2><p>Find a tool, follow its progress, or meet the person behind it.</p></div></div><div class="hub-grid"><a class="hub-card reveal" href="/projects"><span class="hub-card-top"><span class="hub-number">01 / DISCOVER</span><%- icon('cube') %></span><h3>Find your next tool.</h3><p>Browse every project by what it does. The collection grows with each new public repository.</p><span class="text-link">The project collection <%- icon('arrow') %></span></a><a class="hub-card reveal" href="/updates"><span class="hub-card-top"><span class="hub-number">02 / FOLLOW</span><%- icon('clock') %></span><h3>See what's changed.</h3><p>A quiet place for the latest published releases, version notes, and downloads.</p><span class="text-link">Latest updates <%- icon('arrow') %></span></a><a class="hub-card reveal" href="/about"><span class="hub-card-top"><span class="hub-number">03 / THE CREATOR</span><%- icon('code') %></span><h3>Meet the creator.</h3><p>The curiosity, the process, and the ideas that connect the Skypixel collection.</p><span class="text-link">Behind the projects <%- icon('arrow') %></span></a></div><div class="home-signature reveal"><span class="signature-dot" aria-hidden="true"></span><p>Made with curiosity by <strong><%= creatorName %></strong>.</p><a class="text-link" href="/about">Behind Skypixel <%- icon('arrow') %></a></div></section>
<% if(contactEnabled){ %><section class="container contact-section" id="contact"><h2>Get in touch.</h2><form class="contact-form" action="/contact" method="post"><div class="contact-grid"><label>Your name<input name="name" required maxlength="100" autocomplete="name"></label><label>Email address<input name="email" type="email" required maxlength="254" autocomplete="email"></label></div><label>Your message<textarea name="message" rows="4" required maxlength="5000"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><button class="button button-gold" type="submit">Send message <%- icon('right') %></button><p class="contact-status" role="status"></p></form></section><% } %>
<%- include('partials/footer') %>

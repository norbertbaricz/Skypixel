<%- include('partials/head') %>
<section class="hero home-hero" aria-label="Welcome to Skypixel Framework"><div class="hero-background" aria-hidden="true"></div><div class="container hero-inner"><div class="hero-emblem hero-enter"><%- include('partials/brand-logo', {size:80, altText:'Skypixel Framework SP emblem', eager:true}) %></div><p class="eyebrow hero-enter">SKYPIXEL FRAMEWORK · BY <%= creatorName.toUpperCase() %></p><h1 class="hero-enter delay-1">Ideas into<br> <span class="gold-text">something useful.</span></h1><p class="hero-description hero-enter delay-2">Tools for your games, your community, and your everyday setup.<br> One identity. Always something new to build.</p><div class="hero-actions hero-enter delay-3"><a class="button button-gold" href="/projects">Explore projects <%- icon('right') %></a><a class="text-link" href="/about">Behind Skypixel <%- icon('arrow') %></a></div><a class="home-scroll hero-enter delay-3" href="#explore" aria-label="Explore the Skypixel hub"><%- icon('down') %></a></div></section>
<section class="container hub-section" id="explore">
    <div class="section-heading reveal"><div><p class="eyebrow">BUILT FOR REAL SETUPS</p><h2>Small ideas. Everyday impact.</h2><p>Different projects, connected by a simple goal: make the things you use feel better.</p></div></div>
    <div class="hub-grid">
        <a class="hub-card reveal" href="/projects?category=Minecraft"><span class="hub-card-top"><span class="hub-number">FOR YOUR WORLDS</span><%- icon('cube') %></span><h3>A better place<br>to play.</h3><p>From fair play to running your own server. Tools that give Minecraft communities more control over their worlds.</p><span class="text-link">Explore Minecraft tools <%- icon('right') %></span></a>
        <a class="hub-card reveal" href="/projects?category=Windows"><span class="hub-card-top"><span class="hub-number">FOR YOUR DESKTOP</span><%- icon('bolt') %></span><h3>Make your setup<br>your own.</h3><p>Useful controls, practical utilities, and less time spent searching through settings. Built around everyday Windows use.</p><span class="text-link">Explore desktop tools <%- icon('right') %></span></a>
        <a class="hub-card reveal" href="/projects?category=Discord"><span class="hub-card-top"><span class="hub-number">FOR YOUR COMMUNITY</span><%- icon('bot') %></span><h3>Bring people<br>together.</h3><p>Moderation, shared activities, and a little personality. Create a community that feels like a place people want to return to.</p><span class="text-link">Explore community tools <%- icon('right') %></span></a>
    </div>
    <div class="home-signature reveal"><span class="signature-dot" aria-hidden="true"></span><p>A personal workshop by <strong><%= creatorName %></strong>. Always learning. Always building.</p><a class="text-link" href="/updates">Follow the progress <%- icon('arrow') %></a></div>
</section>
<% if(contactEnabled){ %><section class="container contact-section" id="contact"><h2>Get in touch.</h2><form class="contact-form" action="/contact" method="post"><div class="contact-grid"><label>Your name<input name="name" required maxlength="100" autocomplete="name"></label><label>Email address<input name="email" type="email" required maxlength="254" autocomplete="email"></label></div><label>Your message<textarea name="message" rows="4" required maxlength="5000"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><button class="button button-gold" type="submit">Send message <%- icon('right') %></button><p class="contact-status" role="status"></p></form></section><% } %>
<%- include('partials/footer') %>

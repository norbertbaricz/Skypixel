<%- include('partials/head') %>
<section class="page-hero container"><p class="eyebrow hero-enter">THE PROJECTS</p><h1 class="hero-enter delay-1">Find something<br> <span class="gold-text">useful.</span></h1><p class="page-description hero-enter delay-2">Browse every public project from <a href="https://github.com/<%= username %>" target="_blank" rel="noopener noreferrer">@<%= username %></a>.</p></section>
<section class="container catalog-section" aria-label="Project catalog"><form id="project-filters" class="catalog-toolbar" role="search"><label class="search-field"><%- icon('search') %><input id="project-search" type="search" name="q" placeholder="Search projects…" aria-label="Search projects" autocomplete="off"></label><details class="catalog-options"><summary>Sort & view</summary><div class="options-panel"><label for="project-sort">Sort by</label><select id="project-sort" name="sort"><option value="featured">Featured</option><option value="updated">Recently updated</option><option value="stars">Most stars</option><option value="name">Name A–Z</option></select><div class="view-switch" role="group" aria-label="Project view"><button class="icon-button active" type="button" data-view="grid" aria-label="Grid view" aria-pressed="true"><%- icon('grid') %></button><button class="icon-button" type="button" data-view="list" aria-label="List view" aria-pressed="false"><%- icon('list') %></button></div></div></details></form><div class="catalog-filter-row"><div class="category-filters" role="group" aria-label="Filter by category"><% [...new Set(['All projects',...projects.map(p=>p.category)])].forEach(category=>{ %><button class="category-filter <%= category === 'All projects' ? 'active' : '' %>" type="button" data-category-filter="<%= category %>" aria-pressed="<%= category === 'All projects' %>"><%= category %><span><%= category === 'All projects' ? projects.length : projects.filter(p=>p.category === category).length %></span></button><% }); %></div><p id="results-count" role="status" aria-live="polite"><%= projects.length %> projects</p></div><div id="project-grid" class="project-grid"><% filterProjects(projects).forEach(project=>{ %><%- include('partials/project-card',{project}) %><% }); %></div><div class="empty-state" id="empty-state" hidden><%- icon('search') %><h2>No projects found.</h2><p>Try another search or category.</p><button id="reset-filters" class="button button-gold" type="button">Clear filters <%- icon('right') %></button></div><p class="catalog-footnote"><span class="sync-status" data-sync-status>Saved catalog</span></p><noscript><p class="noscript-note">All projects are shown. <a href="https://github.com/<%= username %>?tab=repositories">Browse the repositories on GitHub</a> for complete documentation.</p></noscript></section>
<%- include('partials/footer') %>

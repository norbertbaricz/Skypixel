# Express server. All variables are optional. Node.js 22.13+.
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
SITE_URL=
CREATOR_ALIAS=MaxUltimat3

# Public repository discovery. Never put a token in public/ or a browser script.
GITHUB_USERNAME=norbertbaricz
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=7000
PROJECTS_REFRESH_MS=600000
# Conservative maximum; the server caps this at 40 attempts per rolling hour.
GITHUB_HOURLY_BUDGET=40
GITHUB_RETRY_MS=60000
# Use a persistent writable volume in production.
GITHUB_CACHE_FILE=

# Optional Express-only contact delivery. Blank SMTP disables the form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when omitted.
CONTACT_TO=

{
  "name": "skypixel",
  "version": "3.1.0",
  "description": "Skypixel Framework \u2014 the project hub by MaxUltimat3.",
  "author": "MaxUltimat3",
  "main": "app.js",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/export-static.js --hosted && node scripts/run-framework.mjs build",
    "test": "node --experimental-strip-types --test test/*.test.js",
    "lint": "eslint .",
    "dev:express": "nodemon app.js",
    "build:static": "node scripts/export-static.js",
    "db:generate": "drizzle-kit generate",
    "predev": "node scripts/export-static.js --hosted",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "portfolio",
    "projects",
    "discord-bot",
    "minecraft",
    "website"
  ],
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.4",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "nodemon": "^3.1.14",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "react-server-dom-webpack": "19.2.6"
  },
  "overrides": {
    "qs": "^6.14.1",
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "type": "module"
}
